# --- Frontend (app/.env.local) ---------------------------------------------
# URL of the FastAPI backend. Leave unset to run the dashboard fully offline
# from the precomputed files in app/public/data (alert actions then run in an
# explicit "offline demo" mode and send nothing).
NADINET_API_URL=http://localhost:8000

# --- Backend ------------------------------------------------------------------
# Where the API reads the exported static data (defaults to app/public/data)
# NADINET_STATIC_DATA=/path/to/app/public/data
NADINET_CORS=http://localhost:3000

# Alert gateway: "console" (default; writes data/processed/alerts/outbox.jsonl,
# sends nothing) or "twilio" (real SMS/voice; test phone only during the build)
NADINET_ALERT_GATEWAY=console
NADINET_TEST_PHONE=+8801XXXXXXXXX
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Public URL of the prerecorded Bangla clip (Twilio must be able to fetch it)
# NADINET_VOICE_CLIP_URL=https://your-host/voices/warning_bangla.mp3

# --- Pipeline -----------------------------------------------------------------
# Sentinel-1 GRD archive. AWS documents this bucket as Requester Pays; in the
# build environment objects were readable over plain HTTPS. If you get 403s,
# use AWS credentials and set AWS_REQUEST_PAYER=requester (egress is charged).
# NADINET_S1_BUCKET=https://sentinel-s1-l1c.s3.amazonaws.com
# Terrain height used to correct Sentinel-1 geolocation (see docs/METHODOLOGY.md)
# NADINET_TERRAIN_H=-26.6
# NADINET_DATA=/path/to/data
